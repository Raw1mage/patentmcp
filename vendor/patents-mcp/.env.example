# patentmcp container secrets — copy to .env and fill in. .env is gitignored.
# docker compose reads .env automatically.

# GCP project for the BigQuery patent dataset.
GOOGLE_CLOUD_PROJECT=gen-lang-client-0857568615
BIGQUERY_MAX_RESULTS=1000

# Path on the HOST to the GCP service-account JSON (mounted read-only into the
# container at /secrets/sa-key.json). Defaults to ~/.config/patents-mcp/sa-key.json.
SA_KEY=/home/youruser/.config/patents-mcp/sa-key.json

# TIPO GPSS official REST API user code (primary search source).
GPSS_USER_CODE=

# EPO OPS OAuth credentials.
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET=
