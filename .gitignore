__pycache__/
output/
.DS_Store
.claude/settings.local.json
.mcp.json
~*

# build / transient artifacts
.venv/
**/.venv/
.tmp/
**/.tmp/

# Repo-local intermediate artefacts for file-type tool workflows (DD-6:
# patentmcp/docxmcp 中間產物一律落 repohome/.src/，持久非-ephemeral，取代 /tmp。gitignored、host 持久、0700）
.src/
**/.src/
*.egg-info/
**/*.egg-info/
.specbase/*.sqlite
.specbase/*.sqlite-shm
.specbase/*.sqlite-wal
# patentdb: local accumulating cross-project patent cache (data, not source;
# auto-created by patentdb_store.py, grows unbounded — 632M of scraped PDFs /
# metadata / figures). Committing it bloats git and — until the /file/status
# cap — its body crashed the webapp. The ./patentdb:/patentdb bind-mount only
# needs the DIRECTORY to exist, not its data in git. Ignore ALL contents, keep
# the dir tracked via .gitkeep (same policy as .specbase/*.sqlite above).
patentdb/**
!patentdb/.gitkeep
build/
dist/
wheels/
*.py[oc]
.ipynb_checkpoints/

# IPC rendezvous
.run/

# secrets — never commit
.env
.env.*
*-key.json
sa-key.json
*.serviceaccount.json
**/credentials*.json
toolrowai-credentials.json

# Test exports
test_export*.json

# samples: scraped patent samples / working data (449M), not source
samples/
