{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patentdrafter.local/specs/patentworks-analysis-boundary/data-schema.json",
  "title": "PatentWorks Analysis Boundary Contracts",
  "description": "Spec-level contract for source-agnostic analysis between retrieval/screening and drafting.",
  "type": "object",
  "required": ["project", "analysisInput", "analysisOutput"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "mode", "architectureSourceOfTruth"],
      "properties": {
        "name": {"const": "PatentDrafter"},
        "mode": {"const": "patentworks-mcp-skill"},
        "architectureSourceOfTruth": {"const": "specs/architecture.md"}
      }
    },
    "analysisInput": {"$ref": "#/$defs/analysisInput"},
    "analysisOutput": {"$ref": "#/$defs/analysisOutput"}
  },
  "$defs": {
    "analysisInput": {
      "type": "object",
      "required": ["sourceType", "materials", "analysisGoal"],
      "properties": {
        "sourceType": {"enum": ["retrieval_mcp", "user_provided", "file", "mixed"]},
        "materials": {"type": "array", "items": {"$ref": "#/$defs/material"}},
        "analysisGoal": {"enum": ["technical_features", "novelty", "claim_mapping", "drafting_basis", "landscape", "fto"]}
      }
    },
    "material": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "content": {"type": "string"},
        "handle": {"$ref": "#/$defs/handle"},
        "metadata": {"type": "object"}
      }
    },
    "handle": {
      "type": "object",
      "required": ["token", "rel"],
      "properties": {
        "token": {"type": "string"},
        "rel": {"type": "string"},
        "download_url": {"type": "string"}
      }
    },
    "analysisOutput": {
      "type": "object",
      "required": ["normalizedMaterials", "technicalFeatures", "differences", "reviewFlags"],
      "properties": {
        "normalizedMaterials": {"type": "array", "items": {"type": "object"}},
        "technicalFeatures": {"type": "array", "items": {"type": "object"}},
        "elementMap": {"type": "array", "items": {"type": "object"}},
        "closestPriorArt": {"type": "array", "items": {"type": "object"}},
        "differences": {"type": "array", "items": {"type": "object"}},
        "draftingBasis": {"type": "object"},
        "reviewFlags": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
